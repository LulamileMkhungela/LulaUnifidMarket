{
  "id": "co.za.lulaproveri.pwa",
  "name": "Lula ProVeri — Verified Pros & Escrow-Protected Jobs",
  "short_name": "ProVeri",
  "description": "South Africa's verified on-demand services marketplace. Post a job, get bids from KYC-verified pros, pay into escrow, release on proof of work. Plus verified vehicles and a free pro microsite.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#063527",
  "theme_color": "#ffffff",
  "lang": "en-ZA",
  "dir": "ltr",
  "categories": ["business", "lifestyle", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Post a job",
      "short_name": "Post job",
      "description": "Describe the work and get bids from verified pros",
      "url": "/post-job?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Find a verified pro",
      "short_name": "Find a pro",
      "description": "Search KYC-verified professionals near you",
      "url": "/find-a-pro?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My bookings",
      "short_name": "Bookings",
      "description": "Track escrow, proof of work and payouts",
      "url": "/bookings?source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/post-job",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "description" }
  },
  "protocol_handlers": [
    { "protocol": "web+lulaproveri", "url": "/deep-link?url=%s" }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "edge_side_panel": { "preferred_width": 420 },
  "related_applications": [],
  "prefer_related_applications": false
}
